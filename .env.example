# Local project paths
PROJECT_ROOT=/home/jimi/projects/port-productivity-mlops-demo
DATA_DIR=/home/jimi/projects/port-productivity-mlops-demo/data
REPORTS_DIR=/home/jimi/projects/port-productivity-mlops-demo/reports
MODELS_DIR=/home/jimi/projects/port-productivity-mlops-demo/models

# Existing homelab services
# Local host access to the existing MLflow container is usually 127.0.0.1:5000.
# Inside docker-compose.demo.yml this is overridden to http://mlflow_server:5000.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
DATABASE_URL=

# MLOps configuration
MODEL_NAME=port_productivity_forecaster
EXPECTED_TERMINALS=T1,T2,T3,T4
FEATURE_VERSION=v1
PIPELINE_VERSION=v1
PROMETHEUS_METRICS_PORT=8015
PROMETHEUS_METRICS_PATH=/home/jimi/projects/port-productivity-mlops-demo/data/monitoring/port_productivity_metrics.prom
PUBLIC_PATH_PREFIX=/ports-mlops

# Traefik / homelab routing
PUBLIC_APPS_HOST=jimitogni.duckdns.org
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=duckdns
PORT_PRODUCTIVITY_PATH_PREFIX=/ports-mlops

# Airflow (docker-compose.airflow.yml)
AIRFLOW_HOST=airflow-jimitogni.duckdns.org
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Set strong values for these in your .env (never commit the real values):
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_MLFLOW_TRACKING_URI=http://mlflow_server:5000
DOCKER_MLFLOW_NETWORK=mlflow_default

